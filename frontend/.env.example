# Copy to .env.local for local development.

# Where the Vite dev server proxies /api and /media. Change the port if
# another project on your machine already holds 8000.
VITE_API_PROXY_TARGET=http://localhost:8000

# Normally leave this unset. The app calls the relative path /api, which the
# dev proxy and nginx both resolve, so dev and deployment behave identically.
# Set it only when the API lives on a genuinely different origin.
# VITE_API_BASE_URL=
