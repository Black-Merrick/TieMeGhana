# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Django
*.sqlite3
/backend/media/
/backend/staticfiles/

# Filmed GhSL footage. Large binaries, kept out of the repository. The folder's
# README explains the naming convention and is tracked.
/backend/footage/*
!/backend/footage/README.md

# The same, for footage kept at the root while it is being filmed and imported.
# `replace_clip_library` reads a folder and uploads to the bucket, so these
# files never need to be in the repository, and 88 MB of video committed once
# is in the history for good.
/clips/

# Environment, never commit real credentials
.env
.env.local
!.env.example

# Node
node_modules/
dist/
dist-ssr/
# vite-plugin-pwa writes the development service worker here, now that the PWA
# is generated during `npm run dev` so installing can be tested where it is built.
frontend/dev-dist/
.vite/
coverage/

# Editors and OS
# LibreOffice writes a lock file beside any open document, and the SRS and
# abstract live in this repository, so one appears whenever they are being read.
.~lock.*#
.DS_Store
.idea/
.vscode/
*.swp

# Personal scratch notes, kept out of the repository.
note.md
