# Copy to .env and fill in. Never commit the real .env.

DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to 1 only when the app is actually served over HTTPS. Enabling it on a
# plain http demo network makes the app unreachable, so it is off by default.
DJANGO_SECURE_SSL=0

# Leave DATABASE_URL unset to fall back to local SQLite for quick dev.
# DATABASE_URL=postgres://tiemeghana:tiemeghana@localhost:5432/tiemeghana

# GhanaNLP Khaya AI, powers Twi ASR, translation, and TTS.
# Wired up in the P0.1 sprint. Left blank, language operations fall back to a
# deterministic stub so the test suite and CI never depend on a live service.
KHAYA_API_KEY=
