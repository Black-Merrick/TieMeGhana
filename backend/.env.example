# Copy to .env and fill in. Never commit the real .env.

DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to 1 only when the app is actually served over HTTPS. Enabling it on a
# plain http demo network makes the app unreachable, so it is off by default.
DJANGO_SECURE_SSL=0

# Leave DATABASE_URL unset to fall back to local SQLite for quick dev.
# DATABASE_URL=postgres://tiemeghana:tiemeghana@localhost:5432/tiemeghana

# GhanaNLP Khaya AI, powers Twi ASR, translation, and TTS.
# Wired up in the P0.1 sprint. Left blank, language operations fall back to a
# deterministic stub so the test suite and CI never depend on a live service.
KHAYA_API_KEY=

# Which language provider to use: auto, stub, or khaya.
#
# Khaya's free tier is metered, so every translation, transcription, and speech
# call spends credit. Leave this on `stub` for normal development even when a
# key is configured, and switch to `khaya` only for a deliberate verification
# run. `auto` picks khaya whenever a key is present, which will spend credit.
LANGUAGE_PROVIDER=stub

# ---------------------------------------------------------------------------
# Media storage: Cloudflare R2
# ---------------------------------------------------------------------------
#
# Leave all five blank for local development. Media then lives in backend/media
# on disk, which is what a fresh clone should do: no cloud account needed to
# run the app or the tests.
#
# Fill them in for any deployment, where it is not optional. A container's
# filesystem is replaced on every restart and deploy, so a prescription issued
# on Monday would have lost its photographs by Tuesday and its QR code would
# resolve to broken images.
#
# R2 rather than S3 because it charges nothing for egress, and this app serves
# video. Getting the values is in SETUP_GUIDE.md, under "Media storage".

# From the R2 page in the Cloudflare dashboard, in the URL and on the bucket.
R2_ACCOUNT_ID=
R2_BUCKET=

# From R2 > Manage API tokens > Create token, with Object Read & Write.
# Shown once. Treat them like the Khaya key: never in a tracked file.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The host files are read from, which is not the host they are written to.
# Either the bucket's public r2.dev address or a custom domain on it. No
# scheme, no trailing slash: pub-xxxxxxxx.r2.dev
R2_PUBLIC_HOST=
