# Copy to .env and fill in. Never commit the real .env.

DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to 1 only when the app is actually served over HTTPS. Enabling it on a
# plain http demo network makes the app unreachable, so it is off by default.
DJANGO_SECURE_SSL=0

# Which origins the browser may call the API from, and which may POST a form to
# the Django admin. Comma separated, and the scheme is required: Django ignores
# a bare hostname here silently, so the setting looks configured and does
# nothing.
#
# Blank means the development defaults, which already cover the Vite ports on
# localhost and 127.0.0.1. Set them on a deployment to the Netlify domain.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Where `import_clips` looks for footage. Blank means backend/footage, which is
# where the README tells you to drop clips, so there is rarely a reason to set
# it.
FOOTAGE_DIR=

# Leave DATABASE_URL unset to fall back to local SQLite for quick dev.
# Blank means local SQLite, which is what a laptop wants. Render supplies
# this one. Example for a local PostgreSQL:
#   postgres://tiemeghana:tiemeghana@localhost:5432/tiemeghana
DATABASE_URL=

# GhanaNLP Khaya AI, powers Twi ASR, translation, and TTS.
# Wired up in the P0.1 sprint. Left blank, language operations fall back to a
# deterministic stub so the test suite and CI never depend on a live service.
KHAYA_API_KEY=

# Which language provider to use: auto, stub, or khaya.
#
# Khaya's free tier is metered, so every translation, transcription, and speech
# call spends credit. Leave this on `stub` for normal development even when a
# key is configured, and switch to `khaya` only for a deliberate verification
# run. `auto` picks khaya whenever a key is present, which will spend credit.
LANGUAGE_PROVIDER=stub

# ---------------------------------------------------------------------------
# Media storage: Cloudflare R2
# ---------------------------------------------------------------------------
#
# Leave all five blank for local development. Media then lives in backend/media
# on disk, which is what a fresh clone should do: no cloud account needed to
# run the app or the tests.
#
# Fill them in for any deployment, where it is not optional. A container's
# filesystem is replaced on every restart and deploy, so a prescription issued
# on Monday would have lost its photographs by Tuesday and its QR code would
# resolve to broken images.
#
# R2 rather than S3 because it charges nothing for egress, and this app serves
# video. Getting the values is in SETUP_GUIDE.md, under "Media storage".

# From the R2 page in the Cloudflare dashboard, in the URL and on the bucket.
R2_ACCOUNT_ID=
R2_BUCKET=

# From R2 > Manage API tokens > Create token, with Object Read & Write.
# Shown once. Treat them like the Khaya key: never in a tracked file.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The host files are read from, which is not the host they are written to.
# Either the bucket's public r2.dev address or a custom domain on it. No
# scheme, no trailing slash: pub-xxxxxxxx.r2.dev
R2_PUBLIC_HOST=


# ---------------------------------------------------------------------------
# The admin account
# ---------------------------------------------------------------------------
#
# Leave blank locally and make the account with `createsuperuser`, which is
# what a terminal is for.
#
# Set them on a deployment. The admin is how a GhSL consultant approves clips,
# and an unapproved clip never plays, so a deployment with no way into the
# admin has a clip library nobody can manage. Render's free tier has no shell,
# so there is no terminal to run `createsuperuser` in: `entrypoint.sh` runs
# `ensure_superuser` on start instead, which reads these.
#
# Creating the account is all it does. An existing one is left alone, so a
# password changed in the admin survives a redeploy.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Set to 1 only to reset a forgotten password, then unset it again. It is the
# only recovery route on a platform with no shell, and left set it resets the
# password on every deploy.
DJANGO_SUPERUSER_FORCE_RESET=
